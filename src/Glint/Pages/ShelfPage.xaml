<UserControl x:Class="Glint.Pages.ShelfPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Glint.Core"
             xmlns:local="clr-namespace:Glint.Pages"
             Background="Transparent">

    <UserControl.Resources>
        <local:ShelfIconConverter x:Key="IconConverter"/>

        <DataTemplate x:Key="TileTemplate">
            <Border x:Name="Tile" Width="96" Height="96" Margin="3" CornerRadius="12"
                    Background="Transparent" ToolTip="{Binding Path}"
                    MouseLeftButtonDown="Tile_MouseLeftButtonDown"
                    MouseLeftButtonUp="Tile_MouseLeftButtonUp"
                    MouseMove="Tile_MouseMove">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Открыть" Click="Open_Click"/>
                        <MenuItem Header="Показать в папке" Click="ShowInFolder_Click"/>
                        <MenuItem Header="Копировать путь" Click="CopyPath_Click"/>
                        <MenuItem Header="Убрать с полки" Click="RemoveMenu_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="FallbackGlyph" Style="{StaticResource Icon}" FontSize="30"
                               Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"
                               Text="{x:Static core:Glyphs.Document}" Visibility="Collapsed"/>
                    <Image x:Name="IconImage" Width="48" Height="48" Margin="0,8,0,0"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="{Binding Converter={StaticResource IconConverter}, Mode=OneTime}"/>

                    <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="11"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" TextAlignment="Center"
                               LineStackingStrategy="BlockLineHeight" LineHeight="14" MaxHeight="28"
                               VerticalAlignment="Top" Margin="6,2,6,0"/>

                    <Button x:Name="RemoveButton" Grid.RowSpan="2" Style="{StaticResource RoundButton}"
                            Width="20" Height="20" Margin="0,4,4,0"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="{DynamicResource CardHoverBrush}"
                            Visibility="Collapsed" ToolTip="Убрать с полки"
                            Click="RemoveButton_Click">
                        <TextBlock Style="{StaticResource Icon}" FontSize="8" Text="{x:Static core:Glyphs.Close}"/>
                    </Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Tile" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                    <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible"/>
                </Trigger>
                <DataTrigger Binding="{Binding Source, ElementName=IconImage}" Value="{x:Null}">
                    <Setter TargetName="FallbackGlyph" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,6" LastChildFill="True">
            <Button x:Name="ClearButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                    Padding="10,4" Content="Очистить"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource SectionTitle}" Text="Полка" Margin="2,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="CountText" Style="{StaticResource MutedText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" Focusable="False"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="Tiles" ItemTemplate="{StaticResource TileTemplate}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Margin="0,0,0,20" Visibility="Collapsed">
            <TextBlock Style="{StaticResource Icon}" FontSize="40" Foreground="{StaticResource MutedBrush}"
                       Text="{x:Static core:Glyphs.Shelf}"/>
            <TextBlock Style="{StaticResource MutedText}" FontSize="13" Margin="0,12,0,0"
                       TextAlignment="Center" TextWrapping="Wrap"
                       Text="Перетащите файлы на пилюлю — они подождут здесь"/>
        </StackPanel>
    </Grid>
</UserControl>
