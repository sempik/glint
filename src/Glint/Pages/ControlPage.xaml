<UserControl x:Class="Glint.Pages.ControlPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Glint.Core"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ToggleTile" TargetType="Button" BasedOn="{StaticResource TileButton}">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <Style x:Key="TileIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="TileStatus" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
    </UserControl.Resources>

    <!-- ~650 x 330: four switches on top, Bluetooth audio and VPN lists below. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <UniformGrid Columns="4" Margin="-3">
            <Button x:Name="WifiTile" Style="{StaticResource ToggleTile}" Click="WifiTile_Click">
                <StackPanel>
                    <TextBlock x:Name="WifiIcon" Style="{StaticResource TileIcon}" Text="{x:Static core:Glyphs.Wifi}"/>
                    <TextBlock Text="Wi-Fi" FontSize="12.5" Margin="0,8,0,0"/>
                    <TextBlock x:Name="WifiStatus" Style="{StaticResource TileStatus}" Text="—"/>
                </StackPanel>
            </Button>
            <Button x:Name="BluetoothTile" Style="{StaticResource ToggleTile}" Click="BluetoothTile_Click">
                <StackPanel>
                    <TextBlock x:Name="BluetoothIcon" Style="{StaticResource TileIcon}" Text="{x:Static core:Glyphs.Bluetooth}"/>
                    <TextBlock Text="Bluetooth" FontSize="12.5" Margin="0,8,0,0"/>
                    <TextBlock x:Name="BluetoothStatus" Style="{StaticResource TileStatus}" Text="—"/>
                </StackPanel>
            </Button>
            <Button x:Name="WindowsThemeTile" Style="{StaticResource ToggleTile}" Click="WindowsThemeTile_Click"
                    ToolTip="Тема Windows: приложения, панель задач и «Пуск»">
                <StackPanel>
                    <TextBlock x:Name="WindowsThemeIcon" Style="{StaticResource TileIcon}" Text="{x:Static core:Glyphs.Moon}"/>
                    <TextBlock Text="Тема Windows" FontSize="12.5" Margin="0,8,0,0"/>
                    <TextBlock x:Name="WindowsThemeStatus" Style="{StaticResource TileStatus}" Text="—"/>
                </StackPanel>
            </Button>
            <Button x:Name="GlintThemeTile" Style="{StaticResource ToggleTile}" Click="GlintThemeTile_Click"
                    ToolTip="Тема Glint: тёмная → светлая → как в Windows">
                <StackPanel>
                    <TextBlock x:Name="GlintThemeIcon" Style="{StaticResource TileIcon}" Text="{x:Static core:Glyphs.Sun}"/>
                    <TextBlock Text="Тема Glint" FontSize="12.5" Margin="0,8,0,0"/>
                    <TextBlock x:Name="GlintThemeStatus" Style="{StaticResource TileStatus}" Text="—"/>
                </StackPanel>
            </Button>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ───── Bluetooth audio ───── -->
            <Border Style="{StaticResource Card}" Padding="12,10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Click="BluetoothSettings_Click"
                                ToolTip="Параметры Windows → Bluetooth">
                            <TextBlock Text="Параметры" Foreground="{DynamicResource AccentBrush}" FontSize="11.5"/>
                        </Button>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Наушники и колонки"/>
                    </DockPanel>
                    <TextBlock x:Name="AudioHint" DockPanel.Dock="Bottom" Style="{StaticResource MutedText}" Margin="0,6,0,0"
                               TextWrapping="Wrap" TextTrimming="None" Visibility="Collapsed"/>
                    <Grid Margin="0,6,0,0">
                        <TextBlock x:Name="AudioEmpty" Style="{StaticResource MutedText}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" TextTrimming="None" MaxWidth="240"
                                   Text="Нет сопряжённых Bluetooth-наушников или колонок"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <StackPanel x:Name="AudioList"/>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- ───── VPN ───── -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12,10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Click="VpnSettings_Click"
                                ToolTip="Параметры Windows → Сеть → VPN">
                            <TextBlock Text="Параметры" Foreground="{DynamicResource AccentBrush}" FontSize="11.5"/>
                        </Button>
                        <TextBlock Style="{StaticResource CardTitle}" Text="VPN Windows"/>
                    </DockPanel>
                    <TextBlock x:Name="VpnHint" DockPanel.Dock="Bottom" Style="{StaticResource MutedText}" Margin="0,6,0,0"
                               TextWrapping="Wrap" TextTrimming="None" Visibility="Collapsed"/>
                    <Grid Margin="0,6,0,0">
                        <TextBlock x:Name="VpnEmpty" Style="{StaticResource MutedText}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" TextTrimming="None" MaxWidth="240"
                                   Text="Нет VPN-подключений Windows. Их добавляют в «Параметры → Сеть → VPN»"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <StackPanel x:Name="VpnList"/>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
