<UserControl x:Class="Glint.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Glint.Core"
             Background="Transparent">

    <!-- Fills the ~650 x 330 page area: media + volume | quick actions, dock underneath. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- ───── Media + volume ───── -->
        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid x:Name="MediaView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Width="64" Height="64" VerticalAlignment="Center">
                                <Border x:Name="ArtFallback" CornerRadius="12" Background="{DynamicResource AccentFillBrush}">
                                    <TextBlock Style="{StaticResource Icon}" Text="{x:Static core:Glyphs.Music}" FontSize="24"/>
                                </Border>
                                <Border x:Name="ArtImage" CornerRadius="12" Visibility="Collapsed">
                                    <Border.Background>
                                        <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ArtistText" Style="{StaticResource MutedText}" FontSize="12.5" Margin="0,3,0,0"/>
                                <TextBlock x:Name="SourceText" Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0" Opacity="0.8"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,14,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid x:Name="ProgressTrack" Height="4">
                                <Border CornerRadius="2" Background="{DynamicResource CardHoverBrush}"/>
                                <Border x:Name="ProgressFill" CornerRadius="2" Background="{DynamicResource AccentFillBrush}"
                                        HorizontalAlignment="Left" Width="0"/>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,5,0,0">
                                <TextBlock x:Name="ElapsedText" Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="TotalText" Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Right"/>
                            </Grid>
                        </Grid>

                        <StackPanel Grid.Row="2" VerticalAlignment="Center">
                            <!-- Current synced lyrics line (Настройки → Индикаторы → Текст песни). -->
                            <TextBlock x:Name="LyricsLine" Style="{StaticResource MutedText}" FontSize="12.5"
                                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,8"
                                       Visibility="Collapsed"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="PrevButton" Style="{StaticResource RoundButton}" ToolTip="Предыдущий">
                                    <TextBlock Style="{StaticResource Icon}" Text="{x:Static core:Glyphs.Previous}"/>
                                </Button>
                                <Button x:Name="PlayPauseButton" Style="{StaticResource RoundButton}" Width="42" Height="42"
                                        Margin="16,0" Background="{DynamicResource CardHoverBrush}" ToolTip="Воспроизвести">
                                    <TextBlock x:Name="PlayPauseIcon" Style="{StaticResource Icon}" Text="{x:Static core:Glyphs.Play}" FontSize="16"/>
                                </Button>
                                <Button x:Name="NextButton" Style="{StaticResource RoundButton}" ToolTip="Следующий">
                                    <TextBlock Style="{StaticResource Icon}" Text="{x:Static core:Glyphs.Next}"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="MediaEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource CardBrush}" HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="{x:Static core:Glyphs.Music}" FontSize="20" Foreground="{DynamicResource MutedBrush}"/>
                        </Border>
                        <TextBlock Text="Ничего не играет" HorizontalAlignment="Center" Margin="0,10,0,0" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource MutedText}" HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="260" Margin="0,4,0,0"
                                   Text="Включите музыку или видео — управление появится здесь"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="VolumeRow" Grid.Row="1" Style="{StaticResource Card}" Padding="4,4,12,4" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="MuteButton" Style="{StaticResource GhostButton}" Padding="8,6" ToolTip="Выключить звук">
                        <TextBlock x:Name="MuteIcon" Style="{StaticResource Icon}" Text="{x:Static core:Glyphs.Volume}"/>
                    </Button>
                    <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource SlimSlider}" Margin="6,0"
                            Minimum="0" Maximum="100" SmallChange="2" LargeChange="10" VerticalAlignment="Center"/>
                    <TextBlock x:Name="VolumeText" Grid.Column="2" Style="{StaticResource MutedText}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Text="0%"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ───── Quick actions ───── -->
        <DockPanel Grid.Column="1">
            <!-- Upcoming reminders and timers, only while there are any (rows filled in code); the quick actions
                 title steps aside to make room. -->
            <StackPanel x:Name="RemindersCard" DockPanel.Dock="Top" Margin="0,0,0,6" Visibility="Collapsed">
                <StackPanel x:Name="ReminderRowsPanel"/>
                <Button x:Name="AllRemindersButton" Style="{StaticResource GhostButton}" Padding="8,2" HorizontalAlignment="Left"
                        Visibility="Collapsed" Focusable="False">
                    <TextBlock x:Name="AllRemindersText" FontSize="11.5" Foreground="{DynamicResource AccentBrush}"/>
                </Button>
            </StackPanel>
            <TextBlock x:Name="QuickActionsTitle" DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Быстрые действия"/>
            <!-- Nine compact tiles: screen tools first, then the rest. Short labels; tooltips say more. -->
            <UniformGrid Columns="3" Rows="3" Margin="-3">
                <Button x:Name="AreaShotButton" Style="{StaticResource TileButton}" Margin="3" Padding="9,7" ToolTip="Скриншот области или окна с пометками">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="{x:Static core:Glyphs.Camera}" FontSize="16" HorizontalAlignment="Left" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="Скриншот" FontSize="11.5" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="FullShotButton" Style="{StaticResource TileButton}" Margin="3" Padding="9,7" ToolTip="Скриншот всего экрана с пометками">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="{x:Static core:Glyphs.Image}" FontSize="16" HorizontalAlignment="Left" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="Весь экран" FontSize="11.5" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="RecordButton" Style="{StaticResource TileButton}" Margin="3" Padding="9,7" ToolTip="Запись экрана в MP4">
                    <StackPanel>
                        <TextBlock x:Name="RecordIcon" Style="{StaticResource Icon}" Text="{x:Static core:Glyphs.Record}" FontSize="16" HorizontalAlignment="Left" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock x:Name="RecordLabel" Text="Запись" FontSize="11.5" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ReadTextButton" Style="{StaticResource TileButton}" Margin="3" Padding="9,7" ToolTip="Распознать текст с экрана и скопировать">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="{x:Static core:Glyphs.ScanText}" FontSize="16" HorizontalAlignment="Left" Foreground="{DynamicResource Accent2Brush}"/>
                        <TextBlock Text="Текст" FontSize="11.5" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="QrButton" Style="{StaticResource TileButton}" Margin="3" Padding="9,7" ToolTip="Прочитать QR-код или штрихкод с экрана">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="{x:Static core:Glyphs.QrCode}" FontSize="16" HorizontalAlignment="Left" Foreground="{DynamicResource Accent2Brush}"/>
                        <TextBlock Text="QR-код" FontSize="11.5" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="EyedropperButton" Style="{StaticResource TileButton}" Margin="3" Padding="9,7" ToolTip="Цвет с экрана с лупой; копирует HEX">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="{x:Static core:Glyphs.Eyedropper}" FontSize="16" HorizontalAlignment="Left" Foreground="{DynamicResource Accent2Brush}"/>
                        <TextBlock Text="Пипетка" FontSize="11.5" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CommandBarTile" Style="{StaticResource TileButton}" Margin="3" Padding="9,7" ToolTip="Командная строка">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="{x:Static core:Glyphs.Search}" FontSize="16" HorizontalAlignment="Left" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="Команды" FontSize="11.5" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="LockButton" Style="{StaticResource TileButton}" Margin="3" Padding="9,7" ToolTip="Заблокировать компьютер">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="{x:Static core:Glyphs.Lock}" FontSize="16" HorizontalAlignment="Left" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="Блокировка" FontSize="11.5" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="DownloadsButton" Style="{StaticResource TileButton}" Margin="3" Padding="9,7" ToolTip="Папка загрузок">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="{x:Static core:Glyphs.Download}" FontSize="16" HorizontalAlignment="Left" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="Загрузки" FontSize="11.5" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>
            </UniformGrid>
        </DockPanel>

        <!-- ───── Dock ───── -->
        <Border x:Name="DockCard" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Card}" Padding="6,4" Margin="0,10,0,0"
                AllowDrop="True">
            <DockPanel LastChildFill="True">
                <Button x:Name="AddDockButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                        Padding="10" VerticalAlignment="Center" ToolTip="Закрепить приложение">
                    <TextBlock Style="{StaticResource Icon}" Text="{x:Static core:Glyphs.Add}" Foreground="{DynamicResource MutedBrush}"/>
                </Button>
                <Grid>
                    <TextBlock x:Name="DockHint" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0"
                               Text="Перетащите сюда ярлык или нажмите «+»"/>
                    <ScrollViewer x:Name="DockScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  Focusable="False">
                        <StackPanel x:Name="DockItems" Orientation="Horizontal" MinHeight="44"/>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
