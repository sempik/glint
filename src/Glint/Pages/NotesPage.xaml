<UserControl x:Class="Glint.Pages.NotesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Glint.Core"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Rich text editor in the same card look as the TextBox style in Theme.xaml. -->
        <Style x:Key="NoteEditor" TargetType="RichTextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="AcceptsTab" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RichTextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Formatting toolbar buttons never take focus, so the selection stays visible in the editor.
             Ten of them plus three dividers come to ~307 DIP and must fit the ~322 DIP editor column. -->
        <Style x:Key="FormatButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <!-- ~650 x 330: folders | notes | editor. The reminders view replaces the last two columns. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="172"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ───── Folders ───── -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <TextBox x:Name="SearchBox" Padding="28,6,8,6" ToolTip="Поиск по всем заметкам (Ctrl+F)"/>
                <TextBlock Style="{StaticResource Icon}" Text="{x:Static core:Glyphs.Search}" FontSize="12"
                           HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"
                           Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock x:Name="SearchPlaceholder" Style="{StaticResource MutedText}" Text="Поиск"
                           VerticalAlignment="Center" Margin="29,0,0,0" IsHitTestVisible="False"/>
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel x:Name="FolderList"/>
            </ScrollViewer>

            <Button x:Name="NewFolderButton" Grid.Row="2" Style="{StaticResource GhostButton}" Padding="8,6" Margin="0,4,0,0"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Focusable="False">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="{x:Static core:Glyphs.Add}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Text="Новая папка" FontSize="12" Margin="8,0,0,0" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ───── Notes list ───── -->
        <Grid x:Name="NotesColumn" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Height="30">
                <Button x:Name="NewNoteButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="8,5"
                        ToolTip="Новая заметка (Ctrl+N)" Focusable="False">
                    <TextBlock Style="{StaticResource Icon}" Text="{x:Static core:Glyphs.Add}" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
                </Button>
                <TextBlock x:Name="ListTitle" Style="{StaticResource SectionTitle}" Margin="4,0,0,0" VerticalAlignment="Center" Text="ВСЕ ЗАМЕТКИ"/>
            </DockPanel>
            <ScrollViewer x:Name="NoteScroll" Grid.Row="1" Margin="0,4,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel x:Name="NoteList"/>
            </ScrollViewer>
            <TextBlock x:Name="ListEmpty" Grid.Row="1" Style="{StaticResource MutedText}" TextWrapping="Wrap" TextTrimming="None"
                       TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0"
                       Text="Здесь пока пусто. Нажмите «+», чтобы создать заметку" Visibility="Collapsed"/>
        </Grid>

        <!-- ───── Editor ───── -->
        <Grid x:Name="EditorColumn" Grid.Column="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- One row: a WrapPanel would push the last button onto a hidden second line. -->
            <StackPanel x:Name="Toolbar" Orientation="Horizontal" Height="30" VerticalAlignment="Center"/>

            <RichTextBox x:Name="Editor" Grid.Row="1" Margin="0,4,0,0" Style="{StaticResource NoteEditor}">
                <RichTextBox.Resources>
                    <!-- Tighter than the FlowDocument default of one blank line between paragraphs. -->
                    <Style TargetType="Paragraph">
                        <Setter Property="Margin" Value="0,0,0,3"/>
                    </Style>
                    <Style TargetType="List">
                        <Setter Property="Margin" Value="0,0,0,3"/>
                        <Setter Property="Padding" Value="18,0,0,0"/>
                    </Style>
                </RichTextBox.Resources>
            </RichTextBox>
            <TextBlock x:Name="EditorPlaceholder" Grid.Row="1" Style="{StaticResource MutedText}" FontSize="13"
                       Margin="12,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" IsHitTestVisible="False"
                       Text="Начните писать…"/>

            <Grid Grid.Row="2" Margin="2,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                <Button x:Name="DeleteNoteButton" Grid.Column="1" Style="{StaticResource GhostButton}" Padding="8,4"
                        ToolTip="Удалить заметку" Focusable="False">
                    <TextBlock Style="{StaticResource Icon}" Text="{x:Static core:Glyphs.Delete}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                </Button>
            </Grid>

            <StackPanel x:Name="EditorEmpty" Grid.RowSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource CardBrush}" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="{x:Static core:Glyphs.Note}" FontSize="20" Foreground="{DynamicResource MutedBrush}"/>
                </Border>
                <TextBlock Text="Нет открытой заметки" HorizontalAlignment="Center" Margin="0,10,0,0" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource MutedText}" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" TextTrimming="None" MaxWidth="240" Margin="0,4,0,0"
                           Text="Выберите заметку слева или создайте новую. В командной строке: «заметка купить хлеб»"/>
            </StackPanel>

            <!-- Undo for a delete; floats over the bottom of the editor for a few seconds. -->
            <Border x:Name="UndoBar" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,10"
                    Padding="12,4,4,4" CornerRadius="12" Background="{DynamicResource MenuBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="UndoText" Text="Заметка удалена" FontSize="12" VerticalAlignment="Center"/>
                    <Button x:Name="UndoButton" Style="{StaticResource GhostButton}" Padding="8,4" Margin="8,0,0,0" Focusable="False">
                        <TextBlock Text="Вернуть" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ───── Reminders (the «Напоминания» entry in the folder list) ───── -->
        <Grid x:Name="RemindersView" Grid.Column="2" Grid.ColumnSpan="3" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ReminderInput"/>
                <TextBlock x:Name="ReminderPlaceholder" Style="{StaticResource MutedText}" FontSize="12.5" VerticalAlignment="Center"
                           Margin="9,0,0,0" IsHitTestVisible="False" Text="Например: завтра в 9 позвонить маме"/>
                <Button x:Name="AddReminderButton" Grid.Column="1" Style="{StaticResource TileButton}" Margin="8,0,0,0"
                        HorizontalContentAlignment="Center" Content="Напомнить" Focusable="False"/>
            </Grid>
            <TextBlock x:Name="ReminderPreview" Grid.Row="1" Style="{StaticResource MutedText}" Margin="4,6,0,8"
                       TextWrapping="Wrap" TextTrimming="None"
                       Text="Через 10 минут…, в 18:30…, завтра в 9…, в пятницу в 7 вечера…, 25.12 в 10:00… — или таймер: «25 мин»"/>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel x:Name="ReminderList"/>
            </ScrollViewer>
            <TextBlock x:Name="RemindersEmpty" Grid.Row="2" Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextTrimming="None" TextAlignment="Center" MaxWidth="320"
                       Text="Напоминаний нет. Их можно ставить и из командной строки: «напомни через 10 минут позвонить маме»"/>
        </Grid>
    </Grid>
</UserControl>
