<UserControl x:Class="Glint.Pages.AgentsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Glint.Core"
             Background="Transparent">

    <!-- ~650 x 330: waiting requests first, then every session; rows are built in code (AgentsPage.xaml.cs). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="8,4" Click="Settings_Click">
                <TextBlock Text="Настройки агентов" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
            </Button>
            <TextBlock x:Name="Summary" Style="{StaticResource SectionTitle}" Margin="2,0,0,0" VerticalAlignment="Center"
                       Text="АГЕНТЫ"/>
        </DockPanel>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,6,0">
            <StackPanel x:Name="List"/>
        </ScrollViewer>

        <StackPanel x:Name="Empty" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                    Visibility="Collapsed">
            <TextBlock Style="{StaticResource Icon}" Text="{x:Static core:Glyphs.Agent}" FontSize="26"
                       Foreground="{DynamicResource MutedBrush}"/>
            <TextBlock x:Name="EmptyTitle" Margin="0,10,0,0" HorizontalAlignment="Center" FontWeight="SemiBold"
                       Text="Агенты пока молчат"/>
            <TextBlock x:Name="EmptyHint" Style="{StaticResource MutedText}" Margin="0,4,0,0" TextAlignment="Center"
                       TextWrapping="Wrap" TextTrimming="None"
                       Text="Запустите Claude Code или Codex — их сессии появятся здесь"/>
        </StackPanel>
    </Grid>
</UserControl>
