<UserControl x:Class="Glint.Pages.SystemPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Glint.Pages"
             Background="Transparent"
             Typography.NumeralAlignment="Tabular">

    <UserControl.Resources>
        <!-- Tabular figures (set on the root) keep numbers from jittering as they change. -->
        <Style x:Key="BigNumber" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="None"/>
            <Setter Property="MinWidth" Value="68"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="Small" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="SmallValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="LoadCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="12,10"/>
        </Style>
    </UserControl.Resources>

    <!-- ~650 x 330: CPU · GPU · RAM on top, disks · network · processes below. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ───── CPU ───── -->
            <Border Style="{StaticResource LoadCard}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="CpuClock" DockPanel.Dock="Right" Style="{StaticResource Small}" Text="—"/>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Процессор"/>
                    </DockPanel>
                    <TextBlock x:Name="CpuName" Style="{StaticResource Small}" Margin="0,2,0,0" Text="—"/>
                    <DockPanel Margin="0,2,0,0">
                        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="CpuThreads" Style="{StaticResource Small}" HorizontalAlignment="Right" Text="—"/>
                            <TextBlock x:Name="CpuUptime" Style="{StaticResource Small}" HorizontalAlignment="Right" Margin="0,1,0,0" Text="—"/>
                        </StackPanel>
                        <TextBlock x:Name="CpuLoad" Style="{StaticResource BigNumber}" Text="—"/>
                    </DockPanel>
                    <local:Sparkline x:Name="CpuSpark" Height="30" Margin="0,4,0,0"/>
                    <local:CoreStrip x:Name="CpuCores" Height="18" Margin="0,6,0,0" ToolTip="Загрузка по потокам"/>
                </StackPanel>
            </Border>

            <!-- ───── GPU ───── -->
            <Border Grid.Column="2" Style="{StaticResource LoadCard}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="GpuTemp" DockPanel.Dock="Right" FontSize="12" FontWeight="SemiBold" Text="" ToolTip="Температура видеокарты"/>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Видеокарта"/>
                    </DockPanel>
                    <TextBlock x:Name="GpuName" Style="{StaticResource Small}" Margin="0,2,0,0" Text="—"/>
                    <DockPanel Margin="0,2,0,0">
                        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="GpuClock" Style="{StaticResource Small}" HorizontalAlignment="Right" Text="—"/>
                            <TextBlock x:Name="GpuFan" Style="{StaticResource Small}" HorizontalAlignment="Right" Margin="0,1,0,0" Text="—"/>
                        </StackPanel>
                        <TextBlock x:Name="GpuLoad" Style="{StaticResource BigNumber}" Text="—"/>
                    </DockPanel>
                    <StackPanel x:Name="GpuMemoryRow" Margin="0,4,0,0">
                        <DockPanel>
                            <TextBlock x:Name="GpuMemoryText" DockPanel.Dock="Right" Style="{StaticResource SmallValue}" Text="—"/>
                            <TextBlock Style="{StaticResource Small}" Text="Видеопамять"/>
                        </DockPanel>
                        <local:MeterBar x:Name="GpuMemoryBar" Margin="0,4,0,0"/>
                    </StackPanel>
                    <DockPanel x:Name="GpuPowerRow" Margin="0,7,0,0">
                        <TextBlock x:Name="GpuPowerText" DockPanel.Dock="Right" Style="{StaticResource SmallValue}" Text="—"/>
                        <TextBlock Style="{StaticResource Small}" Text="Питание"/>
                    </DockPanel>
                    <local:Sparkline x:Name="GpuSpark" Height="18" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- ───── RAM ───── -->
            <Border Grid.Column="4" Style="{StaticResource LoadCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Память"/>
                    <TextBlock x:Name="RamText" Style="{StaticResource Small}" Margin="0,2,0,0" Text="—"/>
                    <DockPanel Margin="0,2,0,0">
                        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Small}" HorizontalAlignment="Right" Text="Выделено"/>
                            <TextBlock x:Name="CommitText" Style="{StaticResource Small}" HorizontalAlignment="Right" Margin="0,1,0,0" Text="—"
                                       ToolTip="Выделенная память (ОЗУ + файл подкачки)"/>
                        </StackPanel>
                        <TextBlock x:Name="RamLoad" Style="{StaticResource BigNumber}" Text="—"/>
                    </DockPanel>
                    <local:MeterBar x:Name="RamBar" Margin="0,6,0,0"/>
                    <local:Sparkline x:Name="RamSpark" Height="38" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="7*"/>
            </Grid.ColumnDefinitions>

            <!-- ───── Disks ───── -->
            <Border Style="{StaticResource LoadCard}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="DiskActive" DockPanel.Dock="Right" Style="{StaticResource Small}" Text="—" ToolTip="Время активности дисков"/>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Диски"/>
                    </DockPanel>
                    <TextBlock x:Name="DiskIo" DockPanel.Dock="Bottom" Style="{StaticResource Small}" Margin="0,4,0,0" Text="—"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="0,4,0,0">
                        <StackPanel x:Name="DriveList"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ───── Network ───── -->
            <Border Grid.Column="2" Style="{StaticResource LoadCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Сеть"/>
                    <TextBlock Style="{StaticResource Small}" Margin="0,8,0,0" Text="↓ Загрузка"/>
                    <TextBlock x:Name="NetDown" FontSize="18" FontWeight="SemiBold" TextTrimming="None" Foreground="{DynamicResource Accent2Brush}" Text="—"/>
                    <TextBlock Style="{StaticResource Small}" Margin="0,8,0,0" Text="↑ Отдача"/>
                    <TextBlock x:Name="NetUp" FontSize="18" FontWeight="SemiBold" TextTrimming="None" Foreground="{DynamicResource AccentBrush}" Text="—"/>
                </StackPanel>
            </Border>

            <!-- ───── Top processes ───── -->
            <Border Grid.Column="4" Style="{StaticResource LoadCard}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="64"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ProcTitle" Style="{StaticResource CardTitle}" Text="Процессы"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource Small}" HorizontalAlignment="Right" Text="ЦП"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource Small}" HorizontalAlignment="Right" Text="ОЗУ"/>
                    </Grid>
                    <StackPanel x:Name="ProcList" Margin="0,4,0,0"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
