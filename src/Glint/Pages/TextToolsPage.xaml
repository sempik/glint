<UserControl x:Class="Glint.Pages.TextToolsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: editor -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBox x:Name="Input"
                     AcceptsReturn="True"
                     AcceptsTab="False"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     Padding="10,8"
                     TextChanged="Input_TextChanged"/>
            <TextBlock x:Name="Placeholder"
                       Style="{StaticResource MutedText}"
                       FontSize="13"
                       Text="Вставьте или наберите текст…"
                       Margin="13,8,0,0"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Left"
                       IsHitTestVisible="False"/>

            <!-- Result chip floats over the bottom of the editor for a moment after each action -->
            <Border x:Name="StatusChip"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    Margin="10,0,10,10"
                    Padding="10,5"
                    CornerRadius="12"
                    Opacity="0"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StatusIcon" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                    <TextBlock x:Name="StatusText" FontSize="12" VerticalAlignment="Center" MaxWidth="320"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="2,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatsText" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- Dictation into the editor at the caret; pressed again (or a pause) finishes it. -->
                    <Button x:Name="MicButton" Focusable="False" Style="{StaticResource GhostButton}" Padding="8,5" ToolTip="Надиктовать текст" Click="MicButton_Click">
                        <TextBlock x:Name="MicIcon" Style="{StaticResource Icon}" FontSize="13"/>
                    </Button>
                    <Button x:Name="PasteButton" Focusable="False" Style="{StaticResource GhostButton}" Padding="8,5" ToolTip="Вставить из буфера" Click="PasteButton_Click">
                        <TextBlock x:Name="PasteIcon" Style="{StaticResource Icon}" FontSize="13"/>
                    </Button>
                    <Button x:Name="CopyButton" Focusable="False" Style="{StaticResource GhostButton}" Padding="8,5" ToolTip="Копировать" Click="CopyButton_Click">
                        <TextBlock x:Name="CopyIcon" Style="{StaticResource Icon}" FontSize="13"/>
                    </Button>
                    <Button x:Name="ClearButton" Focusable="False" Style="{StaticResource GhostButton}" Padding="8,5" ToolTip="Очистить" Click="ClearButton_Click">
                        <TextBlock x:Name="ClearIcon" Style="{StaticResource Icon}" FontSize="13"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Right: tool groups -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="3" HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="ToolsTab" Style="{StaticResource TabButton}" GroupName="TextToolsMode" IsChecked="True" Checked="ModeTab_Checked">
                        <TextBlock Text="Инструменты" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                    </RadioButton>
                    <RadioButton x:Name="EncodingTab" Grid.Column="1" Style="{StaticResource TabButton}" GroupName="TextToolsMode" Checked="ModeTab_Checked">
                        <TextBlock Text="Кодирование" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                    </RadioButton>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <UniformGrid x:Name="ToolsGrid" Columns="2" VerticalAlignment="Top"/>
                    <UniformGrid x:Name="EncodingGrid" Columns="2" VerticalAlignment="Top" Visibility="Collapsed"/>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
