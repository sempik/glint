<Window x:Class="Glint.Capture.CaptureResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Glint.Core"
        Title="Glint"
        WindowStyle="None" ResizeMode="NoResize" SizeToContent="Height" Width="480"
        ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!-- A small card with what was read from the screen; the text stays editable before copying. -->
    <Border BorderThickness="1" BorderBrush="{DynamicResource DividerBrush}" Padding="16,14,14,14">
        <StackPanel>
            <DockPanel>
                <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="8,6"
                        VerticalAlignment="Top" ToolTip="Закрыть (Esc)" Focusable="False">
                    <TextBlock Style="{StaticResource Icon}" Text="{x:Static core:Glyphs.Close}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                </Button>
                <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource CardBrush}" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderIcon" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentBrush}"/>
                </Border>
                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitle" FontWeight="SemiBold"/>
                    <TextBlock x:Name="HeaderSubtitle" Style="{StaticResource MutedText}" Margin="0,1,0,0"/>
                </StackPanel>
            </DockPanel>
            <TextBox x:Name="ResultBox" Margin="0,12,0,0" MinHeight="40" MaxHeight="280"
                     TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            <StackPanel x:Name="Actions" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"/>
        </StackPanel>
    </Border>
</Window>
