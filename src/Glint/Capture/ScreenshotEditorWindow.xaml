<Window x:Class="Glint.Capture.ScreenshotEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Glint.Core"
        Title="Glint — скриншот"
        MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!-- Toolbar on top, the picture in the middle (fit to the window, never enlarged), actions at the bottom. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tools · colours · sizes · undo/redo; all filled in code so they share one look. -->
        <WrapPanel Margin="10,10,10,8" VerticalAlignment="Center">
            <StackPanel x:Name="ToolPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
            <Border Width="1" Height="22" Margin="8,0" Background="{DynamicResource DividerBrush}" VerticalAlignment="Center"/>
            <StackPanel x:Name="ColorPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
            <Border Width="1" Height="22" Margin="8,0" Background="{DynamicResource DividerBrush}" VerticalAlignment="Center"/>
            <StackPanel x:Name="SizePanel" Orientation="Horizontal" VerticalAlignment="Center"/>
            <Border Width="1" Height="22" Margin="8,0" Background="{DynamicResource DividerBrush}" VerticalAlignment="Center"/>
            <Button x:Name="UndoButton" Style="{StaticResource GhostButton}" Padding="9,7" ToolTip="Отменить (Ctrl+Z)" IsEnabled="False" Focusable="False">
                <TextBlock Style="{StaticResource Icon}" Text="{x:Static core:Glyphs.Undo}"/>
            </Button>
            <Button x:Name="RedoButton" Style="{StaticResource GhostButton}" Padding="9,7" ToolTip="Повторить (Ctrl+Y)" IsEnabled="False" Focusable="False">
                <TextBlock Style="{StaticResource Icon}" Text="{x:Static core:Glyphs.Redo}"/>
            </Button>
        </WrapPanel>

        <Border Grid.Row="1" Margin="10,0" CornerRadius="12" Background="{DynamicResource CardBrush}" ClipToBounds="True">
            <Viewbox x:Name="Fit" Stretch="Uniform" StretchDirection="DownOnly" Margin="10">
                <!-- CropHost shows only the cropped part; Surface holds the picture and the marks in image pixels. -->
                <Border x:Name="CropHost" ClipToBounds="True" Background="Transparent" Cursor="Cross">
                    <Canvas x:Name="Surface" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Image x:Name="BaseImage" Stretch="Fill"/>
                    </Canvas>
                </Border>
            </Viewbox>
        </Border>

        <DockPanel Grid.Row="2" Margin="14,8,10,10" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="SaveAsButton" Style="{StaticResource GhostButton}" Padding="9,7" ToolTip="Сохранить как… (Ctrl+Shift+S)" Focusable="False">
                    <TextBlock Style="{StaticResource Icon}" Text="{x:Static core:Glyphs.More}"/>
                </Button>
                <Button x:Name="SaveButton" Style="{StaticResource TileButton}" Margin="6,0,0,0" Padding="12,7" Focusable="False"
                        ToolTip="Сохранить PNG в «Изображения\Glint» и скопировать (Ctrl+S)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="{x:Static core:Glyphs.Save}" FontSize="13"/>
                        <TextBlock Text="Сохранить" Margin="8,0,0,0" FontSize="12.5"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CopyButton" Style="{StaticResource TileButton}" Margin="6,0,0,0" Padding="12,7" Focusable="False"
                        ToolTip="Скопировать в буфер обмена и закрыть (Ctrl+C)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="{x:Static core:Glyphs.Copy}" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="Копировать" Margin="8,0,0,0" FontSize="12.5" Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
